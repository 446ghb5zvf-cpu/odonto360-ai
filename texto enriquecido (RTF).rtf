            ['caries', 'restoration', 'endo', 'crown', 'implant', 'missing', 'clear'].forEach(t => \{\
                const b = document.getElementById(`tool-$\{t\}`);\
                if(b) b.classList.remove('border-slate-900', 'border-2');\
            \});\
            const activeB = document.getElementById(`tool-$\{tool\}`);\
            if(activeB) activeB.classList.add('border-slate-900', 'border-2');\
        \}\
\
        function renderQuadrant(containerId, teeth) \{\
            const container = document.getElementById(containerId);\
            container.innerHTML = teeth.map(t => `\
                <div class="tooth-box" id="tooth-box-$\{t\}">\
                    <span class="text-slate-500 font-bold mb-1">$\{t\}</span>\
                    <div class="tooth-crown" id="crown-$\{t\}">\
                        <div class="tooth-surface surf-v" onclick="applyOdontogramFinding($\{t\}, 'V')" title="Vestibular"></div>\
                        <div class="tooth-surface surf-p" onclick="applyOdontogramFinding($\{t\}, 'P')" title="Palatino"></div>\
                        <div class="tooth-surface surf-m" onclick="applyOdontogramFinding($\{t\}, 'M')" title="Mesial"></div>\
                        <div class="tooth-surface surf-d" onclick="applyOdontogramFinding($\{t\}, 'D')" title="Distal"></div>\
                        <div class="tooth-surface surf-o" onclick="applyOdontogramFinding($\{t\}, 'O')" title="Oclusal"></div>\
                    </div>\
                </div>\
            `).join('');\
        \}\
\
        function applyOdontogramFinding(tooth, surface) \{\
            const key = `$\{activePatientId\}_$\{tooth\}_$\{surface\}`;\
            const box = document.getElementById(`tooth-box-$\{tooth\}`);\
\
            if(currentTool === 'missing') \{\
                box.classList.toggle('tooth-missing-x');\
                odontogramFindings[`$\{activePatientId\}_$\{tooth\}_missing`] = true;\
            \} else if(currentTool === 'clear') \{\
                delete odontogramFindings[key];\
                delete odontogramFindings[`$\{activePatientId\}_$\{tooth\}_missing`];\
                box.classList.remove('tooth-missing-x');\
            \} else \{\
                odontogramFindings[key] = currentTool;\
            \}\
            updateOdontogramUI();\
        \}\
\
        function updateOdontogramUI() \{\
            document.querySelectorAll('.tooth-surface').forEach(el => el.className = el.className.replace(/finding-\\w+/g, '').trim());\
            const summary = [];\
\
            Object.keys(odontogramFindings).forEach(k => \{\
                if(k.startsWith(`$\{activePatientId\}_`)) \{\
                    const parts = k.split('_');\
                    const tooth = parts[1];\
                    const surf = parts[2];\
                    if(surf === 'missing') \{\
                        const box = document.getElementById(`tooth-box-$\{tooth\}`);\
                        if(box) box.classList.add('tooth-missing-x');\
                        summary.push(`\'95 Pieza $\{tooth\}: Ausente / Extracci\'f3n`);\
                    \} else \{\
                        const el = document.querySelector(`#crown-$\{tooth\} .surf-$\{surf.toLowerCase()\}`);\
                        if(el) el.classList.add(`finding-$\{odontogramFindings[k]\}`);\
                        summary.push(`\'95 Pieza $\{tooth\} [$\{surf\}]: $\{odontogramFindings[k].toUpperCase()\}`);\
                    \}\
                \}\
            \});\
\
            const sumContainer = document.getElementById('odontogramSummaryList');\
            if(summary.length === 0) \{\
                sumContainer.innerHTML = '<p class="text-slate-400 italic">No hay hallazgos registrados en este expediente.</p>';\
            \} else \{\
                sumContainer.innerHTML = summary.map(s => `<p>$\{s\}</p>`).join('');\
            \}\
        \}\
\
        function saveOdontogram() \{\
            localStorage.setItem('odonto360_odontogram', JSON.stringify(odontogramFindings));\
            alert('Odontograma guardado correctamente.');\
        \}\
\
        function resetOdontogram() \{\
            Object.keys(odontogramFindings).forEach(k => \{\
                if(k.startsWith(`$\{activePatientId\}_`)) delete odontogramFindings[k];\
            \});\
            document.querySelectorAll('.tooth-missing-x').forEach(b => b.classList.remove('tooth-missing-x'));\
            updateOdontogramUI();\
        \}\
\
        // Periodontal Table\
        function renderPeriodontalTable() \{\
            const teeth = [16, 11, 26, 36, 31, 46];\
            const tbody = document.getElementById('periodontalTableBody');\
            tbody.innerHTML = teeth.map(t => `\
                <tr>\
                    <td class="p-2 border font-bold text-slate-700">$\{t\}</td>\
                    <td class="p-1 border"><input type="number" value="2" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="number" value="3" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="number" value="2" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="number" value="3" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="number" value="2" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="number" value="3" class="w-10 text-center border rounded"></td>\
                    <td class="p-1 border"><input type="checkbox"></td>\
                </tr>\
            `).join('');\
        \}\
\
        function loadDrugInfo() \{\
            const drug = document.getElementById('drugSelect').value;\
            const box = document.getElementById('drugInfoBox');\
            if(drug === 'amoxicilina') \{\
                box.innerHTML = `<p><strong>Indicaci\'f3n:</strong> Infecciones odontog\'e9nicas.</p><p><strong>Dosis Adultos:</strong> 500 mg cada 8 horas por 7 d\'edas.</p><p><strong>Advertencia:</strong> Consultar alergias previas.</p>`;\
            \} else if(drug === 'ibuprofeno') \{\
                box.innerHTML = `<p><strong>Indicaci\'f3n:</strong> Dolor e inflamaci\'f3n moderada.</p><p><strong>Dosis Adultos:</strong> 600 mg cada 8 horas v\'eda oral.</p><p><strong>Precauci\'f3n:</strong> Evitar en antecedentes g\'e1stricos o renales.</p>`;\
            \} else \{\
                box.innerHTML = `<p><strong>Indicaci\'f3n:</strong> Analg\'e9sico y antipir\'e9tico.</p><p><strong>Dosis Adultos:</strong> 500 mg - 1g cada 6 horas.</p>`;\
            \}\
        \}\
    </script>\
</body>\
</html>\
}